FROM jieqiu0630/llmlift-base:latest

# ── Convenience tooling ──────────────────────────────────────
RUN apt-get update -y && apt-get install -y --no-install-recommends \
      vim \
    && rm -rf /var/lib/apt/lists/*

# ── Python deps (rebuild only when lock file changes) ───────
WORKDIR /app
COPY pyproject.toml poetry.toml poetry.lock ./
RUN poetry install --no-interaction --no-ansi --no-root --without benchmark

# ── Project source ──────────────────────────────────────────
COPY . .
RUN poetry install --no-interaction --no-ansi --without benchmark

# ── Build custom LLVM pass (needed by compile-add-blocks) ───
RUN cd /app/llvm-pass && mkdir -p build && cd build && cmake .. && make

ENV PATH="/app:/app/.venv/bin:${PATH}" \
    PYTHONPATH="/app"
