FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# ── System deps ──────────────────────────────────────────────
RUN apt-get update -y && apt-get install -y --no-install-recommends \
      ca-certificates curl git build-essential pkg-config m4 xz-utils \
      python3 python3-venv python3-pip \
      libhdf5-dev libopencv-dev libboost-all-dev libmpfr-dev \
    && rm -rf /var/lib/apt/lists/*

# ── Python deps (rebuild only when lock file changes) ───────
WORKDIR /app
COPY pyproject.toml poetry.toml poetry.lock ./
RUN poetry install --no-interaction --no-ansi --no-root
RUN /app/.venv/bin/pip install --no-cache-dir meson ninja cmake

# ── Racket + Rosette ────────────────────────────────────────
RUN curl -fsSL --retry 5 --connect-timeout 30 \
      https://mirror.racket-lang.org/installers/8.7/racket-8.7-x86_64-linux.sh \
      -o /tmp/racket.sh && \
    printf "yes\n1\n" | bash /tmp/racket.sh --unix-style --dest /usr/ && \
    rm /tmp/racket.sh && \
    raco pkg remove --auto rosette || true && \
    raco pkg install --auto \
      https://github.com/emina/rosette.git#10178550a0a21e6d80598d0f43c33c9228728f14 && \
    racket -e '(require rosette/solver/smt/bitwuzla)' && \
    test -f /root/.local/share/racket/8.7/pkgs/rosette/rosette/solver/smt/bitwuzla.rkt

# ── GMP 6.3 + MPFR 4.2 (needed by Bitwuzla) ────────────────
RUN curl -fsSL https://ftp.gnu.org/gnu/gmp/gmp-6.3.0.tar.xz | tar -xJ -C /tmp && \
    cd /tmp/gmp-6.3.0 && \
    ./configure --prefix=/usr/local && \
    make -j"$(nproc)" && \
    make install && \
    ldconfig && \
    rm -rf /tmp/gmp-6.3.0

RUN curl -fsSL https://ftp.gnu.org/gnu/mpfr/mpfr-4.2.1.tar.xz | tar -xJ -C /tmp && \
    cd /tmp/mpfr-4.2.1 && \
    ./configure --prefix=/usr/local --with-gmp=/usr/local && \
    make -j"$(nproc)" && \
    make install && \
    ldconfig && \
    rm -rf /tmp/mpfr-4.2.1

ENV PKG_CONFIG_PATH="/usr/local/lib/pkgconfig:/usr/local/lib64/pkgconfig" \
    LD_LIBRARY_PATH="/usr/local/lib:/usr/local/lib64"

# ── Bitwuzla (SMT solver for Rosette) ───────────────────────
RUN git clone --depth 1 https://github.com/bitwuzla/bitwuzla /opt/bitwuzla && \
    cd /opt/bitwuzla && \
    python3 ./configure.py && \
    ninja -C build

ENV BITWUZLA_PATH="/opt/bitwuzla/build/src/main/bitwuzla"

RUN test -x /opt/bitwuzla/build/src/main/bitwuzla && \
    printf '%s\n' \
      '#lang rosette' \
      '(require rosette/solver/smt/bitwuzla)' \
      '(current-solver (bitwuzla #:path "/opt/bitwuzla/build/src/main/bitwuzla"))' \
      '(displayln "bitwuzla-ok")' \
    > /tmp/rosette-bitwuzla-check.rkt && \
    racket /tmp/rosette-bitwuzla-check.rkt

# ── Project source ──────────────────────────────────────────
COPY . .
RUN poetry install --no-interaction --no-ansi

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONPATH="/app"
